        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
